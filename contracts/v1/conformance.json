{
  "api_version": "v1",
  "canonical_requests": {
    "batch": {
      "example": {
        "inputs": [
          {
            "input_id": "asset-a",
            "source": "https://cdn.example.com/media/a.mp4"
          },
          {
            "input_id": "asset-b",
            "source": {
              "url": "https://cdn.example.com/media/b.mp4"
            }
          }
        ],
        "outputs": [
          "video.web"
        ]
      },
      "input_required_fields": [
        "source"
      ],
      "required_fields": [
        "inputs",
        "outputs"
      ]
    },
    "single": {
      "example": {
        "outputs": [
          "video.web"
        ],
        "source": "https://cdn.example.com/media/source.mp4"
      },
      "required_fields": [
        "source",
        "outputs"
      ]
    }
  },
  "compatibility": {
    "accepted_legacy_source_field": "file_url",
    "accepted_legacy_source_scopes": [
      "single",
      "batch_item"
    ],
    "canonical_source_field": "source"
  },
  "delivery_contract": {
    "bundle": {
      "archive_type": "zip",
      "polling_path": "bundle",
      "polling_fields": [
        "available",
        "download_url",
        "expires_at",
        "size_bytes",
        "sha256",
        "retention_days"
      ],
      "webhook_path": "delivery.bundle",
      "webhook_fields": [
        "type",
        "filename",
        "size_bytes",
        "download.url",
        "download.expiresAt"
      ]
    },
    "parity": [
      {
        "polling_path": "status",
        "semantic": "terminal status",
        "webhook_path": "status"
      },
      {
        "polling_path": "metadata",
        "semantic": "caller request metadata",
        "webhook_path": "meta.request_metadata"
      },
      {
        "polling_path": "bundle.size_bytes",
        "semantic": "bundle size",
        "webhook_path": "delivery.bundle.size_bytes"
      }
    ],
    "url_note": "Polling and webhook download URLs may be different valid, expiring URLs and are intentionally not equality-constrained."
  },
  "error_responses": {
