      { "code": "authentication_error", "retryable": false, "status": 401 },
      { "code": "billing_required", "retryable": false, "status": 402 },
      { "code": "permission_denied", "retryable": false, "status": 403 },
      { "code": "not_found", "retryable": false, "status": 404 },
      { "code": "conflict", "retryable": true, "status": 409 },
      { "code": "gone", "retryable": false, "status": 410 },
      { "code": "request_too_large", "retryable": false, "status": 413 },
      { "code": "unprocessable_entity", "retryable": false, "status": 422 },
      { "code": "rate_limited", "retryable": true, "status": 429 },
      { "code": "internal_error", "retryable": true, "status": 500 },
      { "code": "upstream_error", "retryable": true, "status": 502 },
      { "code": "service_unavailable", "retryable": true, "status": 503 }
